{
  "name": "deps-finder",
  "version": "0.7.0",
  "description": "A TypeScript dependency analyzer that detects unused and misplaced dependencies",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "deps-finder": "./bin/cli.js"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "validate": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "prepublishOnly": "bun run validate && bun run build",
    "prepare": "husky"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "dependency",
    "analyzer",
    "typescript",
    "unused",
    "devDependencies",
    "npm",
    "package-manager",
    "bun"
  ],
  "author": "yuniithings@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jazz1x/deps-finder.git"
  },
  "homepage": "https://github.com/jazz1x/deps-finder#readme",
  "bugs": {
    "url": "https://github.com/jazz1x/deps-finder/issues"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.151.0",
    "@types/bun": "^1.4.2",
    "@types/postcss-less": "^4.0.7",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117",
    "ignore": "^7.0.10",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "oxc-parser": "^0.151.0",
    "postcss": "^8.5.28",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "yaml": "^2.9.1"
  }
}
