{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist"]
}
